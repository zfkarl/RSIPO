# Copy to .env and fill in. scripts/rsipo/env.sh and the SFT scripts read this file.

# Working directory for data/ and runs/ (default: <repo>/work) and the directory of Hugging Face models.
RSIPO_WORK=/path/to/work
MODELS_ROOT=/path/to/models

# ALFWorld data downloaded by `alfworld-download -f` (contains json_2.1.1/).
ALFWORLD_DATA=/path/to/alfworld

# Search-based tasks: searchR1_processed_direct/ (train/test parquet) and searchR1/ (e5 index and corpus).
SEARCH_DATA=/path/to/search-data
SEARCH_URL=http://127.0.0.1:8000/retrieve

# OpenAI-compatible endpoint of the external LLM that writes the skills for the SFT data (GLM-5.2 in the paper).
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=glm-5.2

# Conda environments used by the SFT scripts (data collection starts vLLM through `conda run`).
CONDA_ENV=rsipo
VLLM_CONDA_ENV=rsipo
SFT_CONDA_ENV=rsipo

# Logging: console only by default; set RSIPO_LOGGER="['console','wandb']" and log in to W&B to use it.
WANDB_MODE=offline
